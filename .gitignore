.build/
.swiftpm/

# npm dependency install for scripts/changelog-parser-check.sh (#2380) —
# package-lock.json is committed for a reproducible pin; node_modules is
# reinstalled by the script (`npm ci`) each run, same as .build/ above.
# .install.lock is a transient mkdir-based mutex the script uses to
# serialize concurrent invocations against the shared node_modules/ dir.
scripts/changelog-parser-check/node_modules/
scripts/changelog-parser-check/.install.lock/

# scripts/test.sh and scripts/ci-test-with-watchdog.sh write captured swift-test
# output + watchdog diagnostics here by default (package-relative, not $TMPDIR —
# #2298: TMPDIR is per-user on macOS, so two concurrent local runs would clobber
# each other's output).
test-diagnostics/

# Swift compiler intermediates. SwiftPM normally writes these under .build/,
# but the macro-plugin build invoked by `swift package diagnose-api-breaking-changes`
# has emitted them to the working-tree root, where `.build/` did not catch them
# (they leaked into a commit once — see the cleanup that added these lines).
*.o
*.d
*.dia
*.swiftdeps

# Un-ignore only the shared xcschemes directory so platform-specific
# test lanes (e.g. iOS Simulator file-protection tests) can be tracked.
# Each intermediate component must be explicitly un-ignored for git to
# descend into the otherwise-ignored .swiftpm/ tree.  Files Xcode may
# auto-generate inside .swiftpm/xcode/ (pbxproj, xcuserstate, etc.) stay
# ignored via the wildcard rules below.
!.swiftpm/
!.swiftpm/xcode/
!.swiftpm/xcode/xcshareddata/
!.swiftpm/xcode/xcshareddata/xcschemes/
!.swiftpm/xcode/xcshareddata/xcschemes/*.xcscheme
.swiftpm/xcode/*.pbxproj
.swiftpm/xcode/*.pbxproj.bak
.swiftpm/xcode/xcuserdata/
DerivedData/
# Generated DocC site — produced by .github/workflows/docs.yml (which rm -rf's
# and regenerates it each run). Never committed; guards against a stray `git add`.
/docs-site/
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
xcuserdata/
.DS_Store
# Claude Code agent state — per-developer, gitignored by default.
# Track only the policy files that document repo-wide conventions:
# `.claude/README.md` (rationale) and `.claude/settings.json` (shared policy
# allowlist, if/when one exists). Per-developer overrides go in
# `settings.local.json` and stay local.
.claude/*
!.claude/README.md
!.claude/settings.json
# Shared project skills (e.g. /ship — the draft-PR review loop). Committed like
# settings.json so the workflow tooling travels with the repo.
!.claude/skills/
!.claude/skills/**
tmp/
.worktrees/
# DX walkthrough + docs/plans per-run artefacts — large + ephemeral (a stray
# 2.9GB run tree once slipped into a checkout via `git add -A`). Ignore
# everything under these run directories EXCEPT the curated markdown
# summaries the repo intentionally tracks (SUMMARY.md, ROOT_CAUSES.md,
# MATRIX.md, RUN-CONFIG.md's siblings). Gitignore negation requires
# un-ignoring each parent directory explicitly (`!dir/`) before a nested
# `!dir/**/*.md` re-inclusion pattern can take effect.
scripts/dx-walkthrough/runs/**
!scripts/dx-walkthrough/runs/**/
!scripts/dx-walkthrough/runs/**/*.md
# The blanket directory re-inclusion above also un-ignores any `.build/`
# nested inside a run (each run builds a throwaway SwiftPM app under
# app/.build/) — the root `.build/` rule near the top of this file matches
# first, but gitignore is last-match-wins by file order, not by pattern
# specificity, so the later `!.../**/` negation overrides it for every path
# under `runs/`, `.build/` included. Concretely, a stray run tree in this
# checkout (2026-07-25_v0.73.0_live-20260725/) would let `git add -A` stage
# 42 of `.build/checkouts/*`'s dependency clones as embedded-git-repo
# gitlinks (git warns "adding embedded git repository" per clone) — not
# their full file trees, since each clone is itself a real `.git` repo, but
# still 42 broken, unfetchable references no clone of this repo could ever
# resolve. Re-ignore explicitly so `git add -A` can't sweep those back in.
scripts/dx-walkthrough/runs/**/.build/
# Phase 4 (iPhone on-device) per-run config — contains device UDID + team ID.
# Never commit; each developer fills in their own. Takes precedence over the
# blanket *.md re-inclusion above (gitignore evaluates rules in file order,
# last match wins).
scripts/dx-walkthrough/runs/**/RUN-CONFIG.md
docs/plans/runs/**
!docs/plans/runs/**/
!docs/plans/runs/**/*.md
# Security audit artefacts — must never be committed; contain detailed
# vulnerability maps with file paths and line numbers.
SECURITY_REMEDIATION_PLAN*.md
SECURITY_AUDIT*.md

# Muter mutation-testing artifacts (baseline rationale was recorded in
# docs/MUTATION-BASELINE-2026-06.md, removed in a 2026-07 hygiene pass —
# see git history)
muter_logs/
*_mutated/
.local-integration-runs/
# Overnight-run JSON data files — ephemeral run output, not living docs.
docs/overnight/*.json

# Eval-run byproducts under docs/plans/archive/runs/. Committed convention is
# CURATED SUMMARIES ONLY — the rendered MATRIX.md plus hand-written plan/*.md
# docs. Everything a sweep emits (per-cell CSVs, aggregated record dumps,
# transcripts, sweep logs) is regenerable scratch and must never be committed;
# re-score from the raw JSONL instead. It bloated the tree by ~6k lines once.
docs/plans/archive/runs/**/*.csv
docs/plans/archive/runs/**/all_records.json
docs/plans/archive/runs/**/*_records.json
docs/plans/archive/runs/**/*.records.json
docs/plans/archive/runs/**/*.jsonl
docs/plans/archive/runs/**/*.run.log
docs/plans/archive/runs/**/*.stdout.txt
docs/plans/archive/runs/**/sweep.log
docs/plans/archive/runs/overnight-matrix-*.log
*.profraw
